<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.cinebook.controller.BookingsController" styleClass="root-pane">
    <top>
        <VBox spacing="10" styleClass="top-bar">
            <padding><Insets top="12" right="18" bottom="12" left="18"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="My Bookings" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Home" onAction="#onBackHome"/>
                <Button text="Cancel Selected" onAction="#onCancelSelected" styleClass="secondary-button"/>
                <Button text="Logout" onAction="#onLogout"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="14" right="18" bottom="18" left="18"/></padding>
            <Label text="Ticket History" styleClass="muted-text"/>
            <TableView fx:id="bookingTable" styleClass="panel" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="codeColumn" text="Code"/>
                    <TableColumn fx:id="movieColumn" text="Movie"/>
                    <TableColumn fx:id="seatColumn" text="Seat"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                    <TableColumn fx:id="paymentColumn" text="Payment Ref"/>
                    <TableColumn fx:id="totalColumn" text="Total"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
