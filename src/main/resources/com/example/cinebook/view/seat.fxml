<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.cinebook.controller.SeatController" styleClass="root-pane">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding><Insets top="12" right="18" bottom="12" left="18"/></padding>
            <Button text="Back" onAction="#onBack"/>
            <Label fx:id="movieTitleLabel" styleClass="section-title"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

            <VBox spacing="12" styleClass="panel" HBox.hgrow="ALWAYS">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="SCREEN" styleClass="muted-text"/>
                <Region styleClass="panel" prefHeight="6"/>
                <GridPane fx:id="seatGrid" hgap="8" vgap="8"/>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="Legend" styleClass="movie-title"/>
                    <Label text="Available" styleClass="muted-text"/>
                    <Label text="VIP" styleClass="muted-text"/>
                    <Label text="Booked" styleClass="muted-text"/>
                    <Label text="Selected" styleClass="muted-text"/>
                </HBox>
            </VBox>

            <VBox spacing="12" prefWidth="320" styleClass="panel">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Order Summary" styleClass="section-title"/>
                <Label text="Selected Seats" styleClass="movie-title"/>
                <Label fx:id="selectedSeatsLabel" styleClass="muted-text" wrapText="true"/>
                <Label text="Total" styleClass="movie-title"/>
                <Label fx:id="totalLabel" styleClass="brand-title"/>
                <Button text="Proceed to Confirm" onAction="#onProceed" styleClass="accent-button" maxWidth="1.7976931348623157E308"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
