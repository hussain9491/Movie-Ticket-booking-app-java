<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.cinebook.controller.LoginController" styleClass="root-pane" spacing="24" alignment="CENTER">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox styleClass="login-hero panel" spacing="10" alignment="CENTER_LEFT" prefWidth="520">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        <Label text="CineBook" styleClass="brand-title"/>
        <Label text="Premium movie ticketing" styleClass="section-title"/>
        <Label text="Book seats, manage bookings, and run your cinema operations in one cinematic dashboard." wrapText="true" styleClass="muted-text"/>
    </VBox>

    <VBox styleClass="login-card" spacing="12" alignment="CENTER" maxWidth="430" prefWidth="430">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <Label text="Welcome Back" styleClass="section-title"/>
        <Label text="Your seat is waiting" styleClass="muted-text"/>

        <TextField fx:id="usernameField" promptText="Username" maxWidth="1.7976931348623157E308"/>
        <TextField fx:id="emailField" promptText="Email (for register)" maxWidth="1.7976931348623157E308"/>
        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="1.7976931348623157E308"/>

        <Button text="Login" styleClass="accent-button" maxWidth="1.7976931348623157E308" onAction="#onLogin"/>
        <Button text="Register" styleClass="secondary-button" maxWidth="1.7976931348623157E308" onAction="#onRegister"/>
        <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" alignment="CENTER" maxWidth="1.7976931348623157E308"/>
    </VBox>
</HBox>
