<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.cinebook.controller.AdminController" styleClass="root-pane">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding><Insets top="12" right="18" bottom="12" left="18"/></padding>
            <Label text="Admin Dashboard" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Home" onAction="#onGoHome"/>
            <Button text="Logout" onAction="#onLogout" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="14" right="18" bottom="18" left="18"/></padding>

            <HBox spacing="10">
                <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Movies" styleClass="muted-text"/>
                    <Label fx:id="moviesCountLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Users" styleClass="muted-text"/>
                    <Label fx:id="usersCountLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Today's Bookings" styleClass="muted-text"/>
                    <Label fx:id="todayBookingsLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="3" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Today's Revenue" styleClass="muted-text"/>
                    <Label fx:id="todayRevenueLabel" styleClass="section-title"/>
                </VBox>
            </HBox>

            <GridPane hgap="10" vgap="10" styleClass="panel">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="Add New Movie" styleClass="movie-title" GridPane.columnSpan="2"/>
                <TextField fx:id="titleField" promptText="Title" GridPane.rowIndex="1"/>
                <TextField fx:id="genreField" promptText="Genre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <TextField fx:id="durationField" promptText="Duration (min)" GridPane.rowIndex="2"/>
                <TextField fx:id="priceField" promptText="Base Price" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Button text="Add Movie" onAction="#onAddMovie" GridPane.rowIndex="3" styleClass="accent-button"/>
                <Button text="Delete Selected Movie" onAction="#onDeleteMovie" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="secondary-button"/>
            </GridPane>

            <TableView fx:id="moviesTable" prefHeight="170" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="movieIdColumn" text="ID"/>
                    <TableColumn fx:id="movieTitleColumn" text="Title"/>
                    <TableColumn fx:id="movieGenreColumn" text="Genre"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Toggle User Active" onAction="#onToggleUserActive" styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="usersTable" prefHeight="150" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="userIdColumn" text="ID"/>
                    <TableColumn fx:id="usernameColumn" text="Username"/>
                    <TableColumn fx:id="roleColumn" text="Role"/>
                    <TableColumn fx:id="activeColumn" text="Active"/>
                </columns>
            </TableView>

            <TableView fx:id="bookingsTable" prefHeight="190" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="bookingCodeColumn" text="Code"/>
                    <TableColumn fx:id="bookingMovieColumn" text="Movie"/>
                    <TableColumn fx:id="bookingSeatColumn" text="Seat"/>
                    <TableColumn fx:id="bookingStatusColumn" text="Status"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
